#!/usr/bin/env bash

# @describe Search certificate transparency logs for SSL/TLS certificates
# @arg query "Search query — domain or subdomain pattern" [string]
# @flag -h --help "Show help information"

# @flag -j --json "Output raw JSON response (streamed as NDJSON)"
# @flag -q --quiet "Suppress colored output and progress indicators"
# @flag --no-header "Don't display header information"
# @flag --csv "Output results in CSV format"
# @flag --sort-date "Sort results by first_seen date (newest first)"
# @option -l --limit "Maximum number of results to return" [int]
# @flag --no-cache "Skip cache and force fresh API query"
# @option --max-age "Cache max age in hours (default: 24)" [int]
# @meta require-tools curl,jq

# ARGC-BUILD {
# This block was generated by argc (https://github.com/sigoden/argc).
# Modifying it manually is not recommended

_argc_run() {
    if [[ "${1:-}" == "___internal___" ]]; then
        _argc_die "error: unsupported ___internal___ command"
    fi
    if [[ "${OS:-}" == "Windows_NT" ]] && [[ -n "${MSYSTEM:-}" ]]; then
        set -o igncr
    fi
    argc__args=("$(basename "$0" .sh)" "$@")
    argc__positionals=()
    _argc_index=1
    _argc_len="${#argc__args[@]}"
    _argc_tools=()
    _argc_parse
    _argc_require_tools "${_argc_tools[@]}"
    if [ -n "${argc__fn:-}" ]; then
        $argc__fn "${argc__positionals[@]}"
    fi
}

_argc_usage() {
    cat <<-'EOF'
Search certificate transparency logs for SSL/TLS certificates

USAGE: certspot [OPTIONS] [QUERY]

ARGS:
  [QUERY]  "Search query — domain or subdomain pattern" [string]

OPTIONS:
  -h, --help               "Show help information"
  -j, --json               "Output raw JSON response (streamed as NDJSON)"
  -q, --quiet              "Suppress colored output and progress indicators"
      --no-header          "Don't display header information"
      --csv                "Output results in CSV format"
      --sort-date          "Sort results by first_seen date (newest first)"
  -l, --limit <LIMIT>      "Maximum number of results to return" [int]
      --no-cache           "Skip cache and force fresh API query"
      --max-age <MAX-AGE>  "Cache max age in hours (default: 24)" [int]
  -V, --version            Print version
EOF
    exit
}

_argc_version() {
    echo certspot 0.0.0
    exit
}

_argc_parse() {
    local _argc_key _argc_action
    local _argc_subcmds=""
    while [[ $_argc_index -lt $_argc_len ]]; do
        _argc_item="${argc__args[_argc_index]}"
        _argc_key="${_argc_item%%=*}"
        case "$_argc_key" in
        --help | -help | -h)
            _argc_usage
            ;;
        --version | -version | -V)
            _argc_version
            ;;
        --)
            _argc_dash="${#argc__positionals[@]}"
            argc__positionals+=("${argc__args[@]:$((_argc_index + 1))}")
            _argc_index=$_argc_len
            break
            ;;
        --json | -j)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--json\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_json:-}" ]]; then
                _argc_die "error: the argument \`--json\` cannot be used multiple times"
            else
                argc_json=1
            fi
            ;;
        --quiet | -q)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--quiet\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_quiet:-}" ]]; then
                _argc_die "error: the argument \`--quiet\` cannot be used multiple times"
            else
                argc_quiet=1
            fi
            ;;
        --no-header)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--no-header\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_no_header:-}" ]]; then
                _argc_die "error: the argument \`--no-header\` cannot be used multiple times"
            else
                argc_no_header=1
            fi
            ;;
        --csv)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--csv\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_csv:-}" ]]; then
                _argc_die "error: the argument \`--csv\` cannot be used multiple times"
            else
                argc_csv=1
            fi
            ;;
        --sort-date)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--sort-date\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_sort_date:-}" ]]; then
                _argc_die "error: the argument \`--sort-date\` cannot be used multiple times"
            else
                argc_sort_date=1
            fi
            ;;
        --limit | -l)
            _argc_take_args "--limit <LIMIT>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_limit:-}" ]]; then
                argc_limit="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--limit\` cannot be used multiple times"
            fi
            ;;
        --no-cache)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--no-cache\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_no_cache:-}" ]]; then
                _argc_die "error: the argument \`--no-cache\` cannot be used multiple times"
            else
                argc_no_cache=1
            fi
            ;;
        --max-age)
            _argc_take_args "--max-age <MAX-AGE>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_max_age:-}" ]]; then
                argc_max_age="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--max-age\` cannot be used multiple times"
            fi
            ;;
        *)
            if _argc_maybe_flag_option "-" "$_argc_item"; then
                _argc_die "error: unexpected argument \`$_argc_key\` found"
            fi
            argc__positionals+=("$_argc_item")
            _argc_index=$((_argc_index + 1))
            ;;
        esac
    done
    _argc_tools=(curl jq)
    if [[ -n "${_argc_action:-}" ]]; then
        $_argc_action
    else
        if [[ "${argc__positionals[0]:-}" == "help" ]] && [[ "${#argc__positionals[@]}" -eq 1 ]]; then
            _argc_usage
        fi
        _argc_match_positionals 0
        local values_index values_size
        IFS=: read -r values_index values_size <<<"${_argc_match_positionals_values[0]:-}"
        if [[ -n "$values_index" ]]; then
            argc_query="${argc__positionals[values_index]}"
        fi
    fi
}

_argc_take_args() {
    _argc_take_args_values=()
    _argc_take_args_len=0
    local param="$1" min="$2" max="$3" signs="$4" delimiter="$5"
    if [[ "$min" -eq 0 ]] && [[ "$max" -eq 0 ]]; then
        return
    fi
    local _argc_take_index=$((_argc_index + 1)) _argc_take_value
    if [[ "$_argc_item" == *=* ]]; then
        _argc_take_args_values=("${_argc_item##*=}")
    else
        while [[ $_argc_take_index -lt $_argc_len ]]; do
            _argc_take_value="${argc__args[_argc_take_index]}"
            if _argc_maybe_flag_option "$signs" "$_argc_take_value"; then
                if [[ "${#_argc_take_value}" -gt 1 ]]; then
                    break
                fi
            fi
            _argc_take_args_values+=("$_argc_take_value")
            _argc_take_args_len=$((_argc_take_args_len + 1))
            if [[ "$_argc_take_args_len" -ge "$max" ]]; then
                break
            fi
            _argc_take_index=$((_argc_take_index + 1))
        done
    fi
    if [[ "${#_argc_take_args_values[@]}" -lt "$min" ]]; then
        _argc_die "error: incorrect number of values for \`$param\`"
    fi
    if [[ -n "$delimiter" ]] && [[ "${#_argc_take_args_values[@]}" -gt 0 ]]; then
        local item values arr=()
        for item in "${_argc_take_args_values[@]}"; do
            IFS="$delimiter" read -r -a values <<<"$item"
            arr+=("${values[@]}")
        done
        _argc_take_args_values=("${arr[@]}")
    fi
}

_argc_match_positionals() {
    _argc_match_positionals_values=()
    _argc_match_positionals_len=0
    local params=("$@")
    local args_len="${#argc__positionals[@]}"
    if [[ $args_len -eq 0 ]]; then
        return
    fi
    local params_len=$# arg_index=0 param_index=0
    while [[ $param_index -lt $params_len && $arg_index -lt $args_len ]]; do
        local takes=0
        if [[ "${params[param_index]}" -eq 1 ]]; then
            if [[ $param_index -eq 0 ]] &&
                [[ ${_argc_dash:-} -gt 0 ]] &&
                [[ $params_len -eq 2 ]] &&
                [[ "${params[$((param_index + 1))]}" -eq 1 ]] \
                ; then
                takes=${_argc_dash:-}
            else
                local arg_diff=$((args_len - arg_index)) param_diff=$((params_len - param_index))
                if [[ $arg_diff -gt $param_diff ]]; then
                    takes=$((arg_diff - param_diff + 1))
                else
                    takes=1
                fi
            fi
        else
            takes=1
        fi
        _argc_match_positionals_values+=("$arg_index:$takes")
        arg_index=$((arg_index + takes))
        param_index=$((param_index + 1))
    done
    if [[ $arg_index -lt $args_len ]]; then
        _argc_match_positionals_values+=("$arg_index:$((args_len - arg_index))")
    fi
    _argc_match_positionals_len=${#_argc_match_positionals_values[@]}
    if [[ $params_len -gt 0 ]] && [[ $_argc_match_positionals_len -gt $params_len ]]; then
        local index="${_argc_match_positionals_values[params_len]%%:*}"
        _argc_die "error: unexpected argument \`${argc__positionals[index]}\` found"
    fi
}

_argc_maybe_flag_option() {
    local signs="$1" arg="$2"
    if [[ -z "$signs" ]]; then
        return 1
    fi
    local cond=false
    if [[ "$signs" == *"+"* ]]; then
        if [[ "$arg" =~ ^\+[^+].* ]]; then
            cond=true
        fi
    elif [[ "$arg" == -* ]]; then
        if (( ${#arg} < 3 )) || [[ ! "$arg" =~ ^---.* ]]; then
            cond=true
        fi
    fi
    if [[ "$cond" == "false" ]]; then
        return 1
    fi
    local value="${arg%%=*}"
    if [[ "$value" =~ [[:space:]] ]]; then
        return 1
    fi
    return 0
}

_argc_require_tools() {
    local tool missing_tools=()
    for tool in "$@"; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            missing_tools+=("$tool")
        fi
    done
    if [[ "${#missing_tools[@]}" -gt 0 ]]; then
        echo "error: missing tools: ${missing_tools[*]}" >&2
        exit 1
    fi
}

_argc_die() {
    if [[ $# -eq 0 ]]; then
        cat
    else
        echo "$*" >&2
    fi
    exit 1
}

_argc_run "$@"

# ARGC-BUILD }

set -euo pipefail

CACHE_DIR="${HOME}/.cache/certspot"
CACHE_MAX_AGE_HOURS="${argc_max_age:-24}"
CERTSPOTTER_URL="https://api.certspotter.com/v1/issuances"

setup_colors() {
  if [ "${argc_quiet:-0}" = 1 ] || [ -z "$TERM" ] || [ "$TERM" = "dumb" ]; then
    bold="" reset="" blue="" green="" yellow="" cyan="" magenta="" red="" white="" bg_yellow="" black=""
  else
    bold=$(tput bold) reset=$(tput sgr0) blue=$(tput setaf 4) green=$(tput setaf 2)
    yellow=$(tput setaf 3) cyan=$(tput setaf 6) magenta=$(tput setaf 5) red=$(tput setaf 1)
    bg_yellow=$(tput setab 3) black=$(tput setaf 0)
  fi
}
setup_colors

bold_text() { printf "${bold}%s${reset}" "$1"; }
red()       { printf "${red}%s${reset}" "$1"; }
green()     { printf "${green}%s${reset}" "$1"; }
yellow()    { printf "${yellow}%s${reset}" "$1"; }
blue()      { printf "${blue}%s${reset}" "$1"; }
cyan()      { printf "${cyan}%s${reset}" "$1"; }
magenta()   { printf "${magenta}%s${reset}" "$1"; }

highlight_match() {
  local text="$1" query="$2" color="$3"

  if [ -z "$query" ] || [ "${argc_quiet:-0}" = "1" ]; then
    printf "%s" "$text"
    return
  fi

  local regex_pattern=$(echo "$query" | sed 's/[][^$()+?{|]/\\&/g')
  regex_pattern=$(echo "$regex_pattern" | sed 's/\*/[^.]*/g')

  if command -v perl >/dev/null 2>&1; then
    printf "%s" "$(echo "$text" | perl -pe "s/($regex_pattern)/${reset}${bg_yellow}${black}${bold}\$1${reset}${color}/gi")"
  else
    printf "%s" "$(echo "$text" | sed -E "s/($regex_pattern)/${reset}${bg_yellow}${black}${bold}&${reset}${color}/gi")"
  fi
}

# --- Cache functions ---

cache_key() {
  # Normalize domain to lowercase, use as filename
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/_/g'
}

cache_get() {
  local domain="$1"
  local key=$(cache_key "$domain")
  local cache_file="${CACHE_DIR}/${key}.json"

  if [ ! -f "$cache_file" ]; then
    return 1
  fi

  # Check age
  local file_age=$(( $(date +%s) - $(stat -c %Y "$cache_file" 2>/dev/null || echo 0) ))
  local max_age_secs=$((CACHE_MAX_AGE_HOURS * 3600))

  if [ "$file_age" -gt "$max_age_secs" ]; then
    return 1
  fi

  cat "$cache_file"
  return 0
}

cache_put() {
  local domain="$1"
  local data="$2"
  local key=$(cache_key "$domain")

  mkdir -p "$CACHE_DIR"
  echo "$data" > "${CACHE_DIR}/${key}.json"
}

# --- API functions ---

# Fetch certificates from Certspotter API.
# With API key: auto-paginates all results.
# Without API key (free tier): returns first 100 results only.
# Transforms to: {"count": N, "results": [{"hostname", "subject_common_name", "first_seen"}, ...]}
fetch_certspotter() {
  local query="$1"
  local all_certs="[]"
  local after=""
  local has_api_key=0
  local auth_header=""

  if [ -n "${CERTSPOTTER_API_KEY:-}" ]; then
    has_api_key=1
    auth_header="Authorization: Bearer ${CERTSPOTTER_API_KEY}"
  fi

  while true; do
    local params="domain=${query}&include_subdomains=true&expand=dns_names"
    if [ -n "$after" ]; then
      params="${params}&after=${after}"
    fi

    local response http_code
    local tmp_body=$(mktemp)

    if [ "$has_api_key" = 1 ]; then
      http_code=$(curl -s --max-time 30 -w "%{http_code}" \
        -H "$auth_header" \
        -o "$tmp_body" \
        "${CERTSPOTTER_URL}?${params}")
    else
      http_code=$(curl -s --max-time 30 -w "%{http_code}" \
        -o "$tmp_body" \
        "${CERTSPOTTER_URL}?${params}")
    fi

    response=$(cat "$tmp_body")
    rm -f "$tmp_body"

    # Handle rate limiting
    if [ "$http_code" = "429" ]; then
      if [ "$has_api_key" = 1 ]; then
        printf "$(red "Rate limited"): Certspotter API rate limit exceeded even with API key\n" >&2
      else
        printf "$(red "Rate limited"): Certspotter free tier (1 req/3min). " >&2
        printf "Set $(yellow "CERTSPOTTER_API_KEY") for unlimited access.\n" >&2
      fi
      # If we already have some results, return what we have
      if [ "$(echo "$all_certs" | jq 'length')" -gt 0 ]; then
        printf "$(yellow "Returning partial results (%d certs fetched).")\n" "$(echo "$all_certs" | jq 'length')" >&2
        break
      fi
      return 1
    fi

    # Check for other errors
    if [ "$http_code" != "200" ]; then
      printf "$(red "Error"): Certspotter API returned HTTP %s\n" "$http_code" >&2
      if echo "$response" | jq -e '.message' >/dev/null 2>&1; then
        printf "$(red "Message"): %s\n" "$(echo "$response" | jq -r '.message')" >&2
      fi
      return 1
    fi

    if ! echo "$response" | jq -e . >/dev/null 2>&1; then
      printf "$(red "Error"): Invalid JSON from Certspotter API\n" >&2
      return 1
    fi

    local count
    count=$(echo "$response" | jq 'length')

    if [ "$count" -eq 0 ]; then
      break
    fi

    all_certs=$(echo "$all_certs" "$response" | jq -s '.[0] + .[1]')

    local total_so_far
    total_so_far=$(echo "$all_certs" | jq 'length')
    if [ "${argc_quiet:-0}" != "1" ]; then
      printf "\r$(cyan "Fetched %d certificates...")" "$total_so_far" >&2
    fi

    # Fewer than 100 = last page
    if [ "$count" -lt 100 ]; then
      break
    fi

    # Free tier: don't attempt pagination (would hit rate limit)
    if [ "$has_api_key" = 0 ]; then
      if [ "${argc_quiet:-0}" != "1" ]; then
        printf "\n$(yellow "Free tier: limited to first 100 certs. Set CERTSPOTTER_API_KEY for full results.")\n" >&2
      fi
      break
    fi

    after=$(echo "$response" | jq -r '.[-1].id')
  done

  # Clear progress line
  if [ "${argc_quiet:-0}" != "1" ]; then
    printf "\r\033[K" >&2
  fi

  # Transform to normalized format
  echo "$all_certs" | jq '
    [.[] | .not_before as $nb | .dns_names[] | {hostname: ., first_seen: $nb}]
    | group_by(.hostname)
    | map(sort_by(.first_seen) | .[0] | {hostname, subject_common_name: .hostname, first_seen})
    | sort_by(.hostname)
    | {count: length, results: .}
  '
}

# Main request function: tries cache first, then API
make_request() {
  local query="$1"

  # Check cache (unless --no-cache)
  if [ "${argc_no_cache:-0}" != "1" ]; then
    local cached
    if cached=$(cache_get "$query"); then
      if [ "${argc_quiet:-0}" != "1" ]; then
        local age=$(( $(date +%s) - $(stat -c %Y "${CACHE_DIR}/$(cache_key "$query").json" 2>/dev/null || echo 0) ))
        local age_human
        if [ "$age" -lt 3600 ]; then
          age_human="$((age / 60))m ago"
        elif [ "$age" -lt 86400 ]; then
          age_human="$((age / 3600))h ago"
        else
          age_human="$((age / 86400))d ago"
        fi
        printf "$(green "Cache hit") (cached %s)\n" "$age_human" >&2
      fi
      echo "$cached"
      return 0
    fi
  fi

  # Fetch from API
  local result
  if result=$(fetch_certspotter "$query"); then
    # Cache the result
    cache_put "$query" "$result"
    echo "$result"
    return 0
  fi

  # API failed — try stale cache as fallback
  local stale_file="${CACHE_DIR}/$(cache_key "$query").json"
  if [ -f "$stale_file" ]; then
    printf "$(yellow "Using stale cache as fallback")\n" >&2
    cat "$stale_file"
    return 0
  fi

  return 1
}

show_help() {
  echo "$(bold_text "Certspot — Certificate Transparency Search")"
  echo ""
  echo "$(bold_text "Description"):"
  echo "  Search certificate transparency logs for SSL/TLS certificates."
  echo "  Uses Certspotter (SSLMate) API. Results cached locally."
  echo ""
  echo "$(bold_text "Usage"):"
  echo "  $(green "$(basename "$0") <domain> [options]")"
  echo ""
  echo "$(bold_text "Examples"):"
  echo "  $(green "$(basename "$0") example.com")"
  echo "  $(green "$(basename "$0") example.com --limit 10")"
  echo "  $(green "$(basename "$0") example.com -j")               # NDJSON"
  echo "  $(green "$(basename "$0") example.com --csv")"
  echo "  $(green "$(basename "$0") example.com --no-cache")       # Force fresh query"
  echo "  $(green "$(basename "$0") example.com --max-age 1")      # Cache 1 hour"
  echo ""
  echo "$(bold_text "Options"):"
  echo "  $(yellow "-l, --limit")       Max results to return"
  echo "  $(yellow "-j, --json")        NDJSON output"
  echo "  $(yellow "-q, --quiet")       No color/progress output"
  echo "  $(yellow "--no-header")       Skip header"
  echo "  $(yellow "--csv")             CSV output"
  echo "  $(yellow "--sort-date")       Sort by first_seen (newest first)"
  echo "  $(yellow "--no-cache")        Skip cache, force fresh API call"
  echo "  $(yellow "--max-age")         Cache TTL in hours (default: 24)"
  echo ""
  echo "$(bold_text "Environment"):"
  echo "  $(yellow "CERTSPOTTER_API_KEY")   API key for unlimited access"
  echo "                        Get one at: https://sslmate.com/signup?for=ct_search_api"
  echo ""
  echo "$(bold_text "Rate Limits"):"
  echo "  Free tier: ~1 request per 3 minutes, 100 certs max per query"
  echo "  With API key: unlimited requests, full pagination"
  echo "  Cache: results cached for ${CACHE_MAX_AGE_HOURS}h in ~/.cache/certspot/"
}

format_search_results() {
  local response="$1"
  local total=$(echo "$response" | jq -r '.count // 0')
  local results_count=$(echo "$response" | jq '.results | length')

  if [ "${argc_no_header:-0}" != "1" ] && [ "${argc_quiet:-0}" != "1" ]; then
    printf "$(bold_text "$(green "=== Certificate Search Results ===")")\n"
    printf "$(yellow "Total Found"): %s unique hostnames\n" "$total"
    printf "$(yellow "Showing"): %s results\n" "$results_count"
    printf "$(yellow "Query"): %s\n" "${argc_query:-}"
    printf "\n"
  fi

  if [ "$total" -eq 0 ]; then
    printf "$(yellow "No certificates found for query: ${argc_query:-}")\n"
    return 0
  fi

  local tmp_file=$(mktemp)

  if [ "${argc_sort_date:-0}" = "1" ]; then
    echo "$response" | jq -c '.results | sort_by(.first_seen) | reverse | .[]' > "$tmp_file"
  else
    echo "$response" | jq -c '.results[]' > "$tmp_file"
  fi

  while read -r cert; do
    hostname=$(echo "$cert" | jq -r '.hostname // "N/A"')
    subject_cn=$(echo "$cert" | jq -r '.subject_common_name // "N/A"')
    first_seen=$(echo "$cert" | jq -r '.first_seen // "N/A"')

    if [ "$first_seen" != "N/A" ] && [ "$first_seen" != "null" ]; then
      formatted_date=$(date -d "$first_seen" '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null || echo "$first_seen")
    else
      formatted_date="N/A"
    fi

    highlighted_hostname=$(highlight_match "$hostname" "${argc_query:-}" "$blue")
    printf "$(yellow "Hostname"): ${blue}%s${reset}\n" "$highlighted_hostname"

    if [ "$subject_cn" != "$hostname" ] && [ "$subject_cn" != "N/A" ]; then
      highlighted_subject_cn=$(highlight_match "$subject_cn" "${argc_query:-}" "$cyan")
      printf "$(yellow "Subject CN"): ${cyan}%s${reset}\n" "$highlighted_subject_cn"
    fi

    printf "$(yellow "First Seen"): %s\n" "$formatted_date"

    if [[ "$hostname" == \*.* ]] || [[ "$subject_cn" == \*.* ]]; then
      printf "$(yellow "Type"): $(magenta "Wildcard Certificate")\n"
    fi

    printf "\n"
  done < "$tmp_file"

  rm -f "$tmp_file"

  if [ "${argc_quiet:-0}" != "1" ] && [ "$total" -gt 0 ]; then
    printf "$(bold_text "$(yellow "Total: $total unique hostnames")")\n"
  fi
}

generate_csv() {
  local response="$1"
  printf "hostname,subject_common_name,first_seen\n"

  if [ "${argc_sort_date:-0}" = "1" ]; then
    echo "$response" | jq -r '.results | sort_by(.first_seen) | reverse | .[] | [.hostname, .subject_common_name, .first_seen] | @csv'
  else
    echo "$response" | jq -r '.results[] | [.hostname, .subject_common_name, .first_seen] | @csv'
  fi
}

do_search() {
  local query="${argc_query:-}"
  local limit="${argc_limit:-}"

  if [ "${argc_quiet:-0}" != "1" ]; then
    printf "$(bold_text "$(cyan "Searching certificate transparency logs...")")\n"
    printf "$(yellow "Query"): %s\n" "$query"
    if [ -n "$limit" ]; then
      printf "$(yellow "Limit"): %s\n" "$limit"
    fi
    printf "\n"
  fi

  local response
  if ! response=$(make_request "$query"); then
    printf "$(red "Error"): Failed to fetch certificate data\n" >&2
    exit 1
  fi

  # Apply limit
  if [ -n "$limit" ]; then
    response=$(echo "$response" | jq ".results = .results[:$limit] | .count = (.results | length)")
  fi

  if [ "${argc_json:-0}" = "1" ]; then
    echo "$response" | jq -c '.results[]'
    exit 0
  fi

  if [ "${argc_csv:-0}" = "1" ]; then
    generate_csv "$response"
    exit 0
  fi

  format_search_results "$response"
}

if [ "${argc_help:-0}" = "1" ]; then
  show_help
  exit 0
fi

if [ -z "${argc_query:-}" ]; then
  printf "$(red "Error"): Search query is required\n" >&2
  printf "\n"
  show_help
  exit 1
fi

do_search
